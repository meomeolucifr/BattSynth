  "workflow": {
    "timeline": [
      {
        "step_ref": "screening_1",
        "description": "Bond-valence kinetic Monte Carlo (BV-KMC) simulations at 300 K performed up to 10 ns or ten-million KMC steps to compute Li-ion conductivity for 49 296 Li-containing compounds (Page B, Methods)."
      },
      {
        "step_ref": "screening_2",
        "description": "Coarse filter applied: EH ≤ 200 meV atom-1 and Eg > 0 eV, reducing set to 20 567 candidates (Figure 2)."
      },
      {
        "step_ref": "screening_3",
        "description": "Transport filter: retain compounds with σ ≥ 0.1 mS cm-1 (10-4 S cm-1) from BV-KMC results, yielding 1 349 candidates (Figure 2)."
      },
      {
        "step_ref": "screening_4",
        "description": "Fine filter: EH ≤ 30 meV atom-1 and Eg > 1 eV, final shortlist 329 stable, insulating candidates; 28 predicted stable versus Li metal (Figure 4)."
      },
      {
        "step_ref": "generation",
        "description": "Isovalent chemical substitution applied to 329 shortlisted materials using similarity rules (5 % replaceability) to generate 979 new structures; 414 metastable (EH ≤ 30 meV atom-1) after relaxation with pretrained M3GNet force field (Figure 6)."
      },
      {
        "step_ref": "ml_screen",
        "description": "Graph Convolutional Network (GCN) models predicted ionic conductivity of generated structures; 284 predicted high-conductivity, validated by BV-KMC giving 239 true positives (Section III.C)."
      }
    ],
    "ambiguities": []
