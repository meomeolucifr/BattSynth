SYNTH_LLM_ENABLED=true
SYNTH_LLM_PROVIDER=openai
SYNTH_LLM_MODEL=gpt-4o-mini
# You can use either SYNTH_LLM_API_KEY or provider-native key names.
SYNTH_LLM_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

SYNTH_ARXIV_ENABLED=true
SYNTH_ARXIV_MAX_RESULTS=5
SYNTH_ARXIV_TIMEOUT=10
# Last resort for corporate MITM/proxy environments:
# SYNTH_ARXIV_ALLOW_INSECURE_SSL=true
